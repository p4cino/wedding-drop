{
	"name": "wedding-drop-monorepo",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@12.4.1",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "turbo run test",
		"test:coverage": "turbo run test:coverage",
		"test:e2e": "pnpm --filter @wedding-drop/web test:e2e",
		"db:push": "turbo run db:push",
		"db:generate": "turbo run db:generate",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"husky": "^9.1.7",
		"turbo": "^2.10.12",
		"typescript": "^7.0.2"
	}
}
