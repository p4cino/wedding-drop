{
	"name": "wedding-drop-monorepo",
	"version": "1.1.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"packageManager": "pnpm@12.4.1",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "turbo run test",
		"test:coverage": "turbo run test:coverage",
		"test:e2e": "pnpm --filter @wedding-drop/web test:e2e",
		"screenshots": "pnpm --filter @wedding-drop/web exec tsx ../../scripts/capture-screenshots.ts",
		"db:push": "turbo run db:push",
		"db:generate": "turbo run db:generate",
		"openspec": "openspec",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@fission-ai/openspec": "^1.14.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"turbo": "^2.11.5",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
