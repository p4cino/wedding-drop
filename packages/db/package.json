{
	"name": "@wedding-drop/db",
	"version": "1.0.0",
	"private": true,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./validators": {
			"types": "./src/validators.ts",
			"default": "./src/validators.ts"
		},
		"./schema": {
			"types": "./src/schema.ts",
			"default": "./src/schema.ts"
		}
	},
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check src/ tests/",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@node-rs/bcrypt": "^1.10.9",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"postgres": "^3.4.9",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.1",
		"drizzle-kit": "^0.31.10",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
}
