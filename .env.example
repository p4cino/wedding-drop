# Domena aplikacji (np. https://nasz-slub.pl lub http://localhost)
APP_DOMAIN=http://localhost

# Hasło głównego administratora (dostęp do /admin)
ADMIN_PASSWORD=admin123

# Baza danych PostgreSQL
DATABASE_URL=postgres://wedding:wedding_secret@postgres:5432/wedding_drop

# Port wewnętrzny i ścieżka wolumenu danych
PORT=3000
HOST=0.0.0.0
DATA_DIR=/app/data

# Google Drive OAuth 2.0 (do eksportu galerii dla Pary Młodej)
# Utwórz poświadczenia OAuth 2.0 w Google Cloud Console z zakresem: https://www.googleapis.com/auth/drive.file
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcjonalnie nadpisz URI zwrotny (domyślnie: ${APP_DOMAIN}/api/auth/google/callback)
GOOGLE_REDIRECT_URI=
